<!-- Health & Transport Dashboard — light card layout -->
<script src="https://usetrmnl.com/js/highcharts/12.3.0/highcharts.js"></script>

{% liquid
  # ---------- Time ----------
  assign now_s = "now" | date: "%s"
  assign utc_offset = trmnl.user.utc_offset | default: 0
  assign now_local = now_s | plus: utc_offset

  # ---------- Glucose ----------
  assign g_value = merge_variables.glucose.value | default: merge_variables.sgv | default: "—"
  assign g_trend_raw = merge_variables.glucose.trend | default: merge_variables.direction | default: "flat"
  assign g_ts = merge_variables.glucose.timestamp | default: merge_variables.datetime

  # Numeric copy of the current value for threshold comparison.
  # Liquid coerces strings like "5.1" when they hit an arithmetic filter.
  assign g_value_num = g_value | times: 1.0

  # Thresholds come from plugin settings (settings.yml → glucose_alert_high/low).
  # TRMNL exposes custom fields as top-level Liquid variables by keyname.
  assign g_high = glucose_alert_high | default: 10.0 | times: 1.0
  assign g_low  = glucose_alert_low  | default: 4.0  | times: 1.0

  assign g_trend_key = g_trend_raw | downcase | replace: " ", "" | replace: "_", "" | replace: "-", ""
  assign trend_symbol = "→"
  case g_trend_key
    when "doubleup" or "risingfast" or "risingfastly"
      assign trend_symbol = "↑↑"
    when "singleup" or "rising"
      assign trend_symbol = "↗"
    when "fortyfiveup" or "risingslowly"
      assign trend_symbol = "↑"
    when "flat" or "stable"
      assign trend_symbol = "→"
    when "fortyfivedown" or "fallingslowly"
      assign trend_symbol = "↓"
    when "singledown" or "falling"
      assign trend_symbol = "↘"
    when "doubledown" or "fallingfast"
      assign trend_symbol = "↓↓"
  endcase

  assign g_alert = false
  if g_value_num > 0
    if g_value_num <= g_low or g_value_num >= g_high
      assign g_alert = true
    endif
  endif

  # ---------- Vital Metrics (Steps + Sleep) ----------
  assign v_steps = merge_variables.health.steps | default: 0
  assign v_sleep_label = merge_variables.health.sleep.duration_label | default: "—"

  # ---------- Schedule ----------
  assign schedule = merge_variables.schedule | default: empty

  # ---------- Transport ----------
  assign tr_location = merge_variables.transport.location | default: "Unknown"
  assign departures = merge_variables.transport.departures | default: empty

  # ---------- Weather ----------
  assign w_temp = merge_variables.weather.temperature.current | default: 0
  assign w_feels = merge_variables.weather.temperature.feels_like | default: 0
  assign w_desc = merge_variables.weather.condition.description | default: "Unknown"
  assign w_type = merge_variables.weather.condition.type | default: ""
  assign w_humidity = merge_variables.weather.humidity | default: 0
  assign w_wind_label = merge_variables.weather.wind.direction_label | default: ""

  assign w_key = w_type | downcase | replace: "_", "" | replace: "-", "" | replace: " ", ""
  if w_key == blank
    assign w_key = w_desc | downcase | replace: " ", "" | replace: "_", "" | replace: "-", ""
  endif

  assign chart_id = "glucose-chart"
%}

<div class="dashboard">
  <div class="grid">

    <!-- ============ LEFT COLUMN ============ -->
    <aside class="col col--left">

      <!-- TIME -->
      <div class="time-block">
        <div class="time-main">{{ now_local | date: "%H:%M" }}</div>
        <div class="time-sub">{{ now_local | date: "%A, %b %-d" | upcase }}</div>
      </div>

      <div class="rule"></div>

      <!-- VITAL METRICS -->
      <div class="section-label">VITAL METRICS</div>
      <div class="vitals">
        <div class="vital">
          <div class="vital__label">STEPS</div>
          <div class="vital__row">
            <div class="vital__value">{{ v_steps }}</div>
            <svg class="vital__icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="13" cy="4.5" r="2" fill="currentColor"/>
              <path d="M7 22l2.5-7 2.8 2.8v5M12 11.5l3.3-1 3.7 3.7M14 14.5l-0.8 2.5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
        <div class="vital">
          <div class="vital__label">SLEEP</div>
          <div class="vital__row">
            <div class="vital__value vital__value--sm">{{ v_sleep_label }}</div>
            <svg class="vital__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="currentColor"/>
            </svg>
          </div>
        </div>
      </div>

      <!-- GLUCOSE -->
      <div class="card card--glucose {% if g_alert %}card--alert{% endif %}">
        <div class="glucose__head">
          <div class="section-label">GLUCOSE LEVEL</div>
          <div class="trend-pill" aria-label="Glucose trend">{{ trend_symbol }}</div>
        </div>
        <div class="glucose__value">{{ g_value }} mmol/L</div>
        <div class="glucose__chart" id="{{ chart_id }}"></div>
        <div class="glucose__updated">
          UPDATED {% if g_ts %}{{ g_ts | date: "%s" | plus: utc_offset | date: "%-I:%M %p" }}{% else %}—{% endif %}
        </div>
      </div>

    </aside>

    <!-- ============ RIGHT COLUMN ============ -->
    <section class="col col--right">

      <!-- UPCOMING SCHEDULE -->
      <div class="card card--schedule">
        <div class="section-label">UPCOMING SCHEDULE</div>
        <div class="schedule">
          {% if schedule.size > 0 %}
            {% for ev in schedule limit: 2 %}
              <div class="schedule__event">
                <div class="schedule__title clamp--1">{{ ev.title | strip }}</div>
                <div class="schedule__time">
                  {% if ev.start contains "T" %}
                    {{ ev.start | date: "%s" | plus: utc_offset | date: "%-I:%M %p" }} – {{ ev.end | date: "%s" | plus: utc_offset | date: "%-I:%M %p" }}
                  {% else %}
                    All day
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          {% else %}
            <div class="schedule__event schedule__event--empty">
              <div class="schedule__title">No upcoming events</div>
            </div>
          {% endif %}
        </div>
      </div>

      <!-- TRANSIT DEPARTURES -->
      <div class="card card--transit">
        <div class="transit__header">
          <div class="transit__title">TRANSIT DEPARTURES</div>
          <svg class="transit__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 17V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v11M5 17h14M5 17v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2M16 17v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2M7 10h10M7.5 13.5h0.01M16.5 13.5h0.01" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="transit__body">
          {% if departures.size > 0 %}
            {% for dep in departures limit: 4 %}
              {% assign route = dep.route | default: "?" %}
              {% assign dest = dep.destination | default: "Unknown" %}
              {% assign mins = dep.mins_away | default: 0 %}
              {% assign delay = dep.delay | default: 0 %}
              <div class="transit-row">
                <div class="transit-row__badge">{{ route }}</div>
                <div class="transit-row__dest clamp--1">{{ dest }}</div>
                <div class="transit-row__time">
                  {% if mins <= 0 %}Now{% else %}{{ mins | round }}m{% endif %}{% if delay and delay > 0 %}<span class="transit-row__delay"> +{{ delay }}m</span>{% endif %}
                </div>
              </div>
              {% unless forloop.last %}<div class="transit-row__rule"></div>{% endunless %}
            {% endfor %}
          {% else %}
            <div class="transit-row--empty">No upcoming departures</div>
          {% endif %}
        </div>
      </div>

      <!-- WEATHER + FORECAST -->
      <div class="weather-row">
        <div class="card card--now">
          <div class="now__icon" aria-hidden="true">
            {% case w_key %}
              {% when "clear" or "sun" or "sunny" %}
                <svg viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="4" fill="currentColor"/>
                  <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                    <line x1="12" y1="1.5" x2="12" y2="5"/>
                    <line x1="12" y1="19" x2="12" y2="22.5"/>
                    <line x1="1.5" y1="12" x2="5" y2="12"/>
                    <line x1="19" y1="12" x2="22.5" y2="12"/>
                    <line x1="4.2" y1="4.2" x2="6.7" y2="6.7"/>
                    <line x1="17.3" y1="17.3" x2="19.8" y2="19.8"/>
                    <line x1="4.2" y1="19.8" x2="6.7" y2="17.3"/>
                    <line x1="17.3" y1="6.7" x2="19.8" y2="4.2"/>
                  </g>
                </svg>
              {% when "cloudy" or "overcast" or "mostlycloudy" %}
                <svg viewBox="0 0 24 24">
                  <path d="M7 18h9a4 4 0 0 0 0-8 5.5 5.5 0 0 0-10.6-1.5A4.5 4.5 0 0 0 7 18z" fill="currentColor"/>
                </svg>
              {% when "rain" or "rainy" or "drizzle" or "lightrain" or "heavyrain" or "showers" %}
                <svg viewBox="0 0 24 24">
                  <path d="M7 14h9a4 4 0 0 0 0-8 5.5 5.5 0 0 0-10.6-1.5A4.5 4.5 0 0 0 7 14z" fill="currentColor"/>
                  <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                    <line x1="8" y1="17" x2="8" y2="21"/>
                    <line x1="12" y1="17" x2="12" y2="21"/>
                    <line x1="16" y1="17" x2="16" y2="21"/>
                  </g>
                </svg>
              {% when "snow" or "snowy" or "sleet" %}
                <svg viewBox="0 0 24 24">
                  <path d="M7 14h9a4 4 0 0 0 0-8 5.5 5.5 0 0 0-10.6-1.5A4.5 4.5 0 0 0 7 14z" fill="currentColor"/>
                  <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                    <line x1="9" y1="17.5" x2="9" y2="20.5"/>
                    <line x1="15" y1="17.5" x2="15" y2="20.5"/>
                  </g>
                </svg>
              {% when "storm" or "thunderstorm" or "thunder" %}
                <svg viewBox="0 0 24 24">
                  <path d="M7 14h9a4 4 0 0 0 0-8 5.5 5.5 0 0 0-10.6-1.5A4.5 4.5 0 0 0 7 14z" fill="currentColor"/>
                  <path d="M11.5 15l-2 4h2.5l-1 3 3.5-5h-2.5l1.2-2z" fill="currentColor"/>
                </svg>
              {% else %}
                <svg viewBox="0 0 24 24">
                  <circle cx="8" cy="8" r="3" fill="currentColor"/>
                  <path d="M9 18h8a3.5 3.5 0 0 0 0-7 4.8 4.8 0 0 0-9.1-1.2A4 4 0 0 0 9 18z" fill="currentColor"/>
                </svg>
            {% endcase %}
          </div>
          <div class="now__text">
            <div class="now__temp">{{ w_temp | round }}°C</div>
            <div class="now__desc">{{ w_desc | upcase }}</div>
          </div>
        </div>

        <div class="card card--forecast">
          <div class="section-label">FORECAST</div>
          <div class="forecast__main">Feels like {{ w_feels | round }}°C</div>
          <div class="forecast__sub">{{ w_humidity | round }}% humidity{% if w_wind_label != blank %} with {{ w_wind_label }} winds{% endif %}.</div>
        </div>
      </div>

    </section>
  </div>
</div>

<!-- ============ GLUCOSE CHART ============ -->
<script>
  (function() {
    var data = {{ merge_variables | json }};
    if (!data || !data.glucose) return;

    // Normalize a time value that might be ms epoch, sec epoch, or ISO string.
    function toMs(raw) {
      if (raw == null) return NaN;
      if (typeof raw === 'number') return raw > 1e12 ? raw : raw * 1000;
      return new Date(raw).getTime();
    }

    // Prefer real history from the webhook. Fall back to a simulated trend line
    // extrapolated from the current value + direction so the card isn't empty.
    var points = [];
    var history = data.glucose.history;
    if (Array.isArray(history) && history.length > 1) {
      for (var i = 0; i < history.length; i++) {
        var p = history[i];
        var t = toMs(p.time || p.datetime || p.timestamp || p.date);
        var v = parseFloat(p.value != null ? p.value : p.sgv);
        if (!isNaN(t) && !isNaN(v)) points.push([t, Math.round(v * 10) / 10]);
      }
      points.sort(function(a, b) { return a[0] - b[0]; });
    } else {
      var current = parseFloat(data.glucose.value != null ? data.glucose.value : data.sgv);
      if (isNaN(current)) return;
      var endTime = toMs(data.glucose.timestamp || data.datetime) || Date.now();
      var key = String(data.glucose.trend || data.direction || 'flat')
        .toLowerCase().replace(/[\s_-]/g, '');
      var slopePerStep = 0;
      if (key === 'doubleup' || key === 'risingfast')      slopePerStep = -0.7;
      else if (key === 'singleup' || key === 'rising')     slopePerStep = -0.45;
      else if (key === 'fortyfiveup' || key === 'risingslowly')     slopePerStep = -0.22;
      else if (key === 'fortyfivedown' || key === 'fallingslowly')  slopePerStep = 0.22;
      else if (key === 'singledown' || key === 'falling')  slopePerStep = 0.45;
      else if (key === 'doubledown' || key === 'fallingfast') slopePerStep = 0.7;
      for (var j = 5; j >= 0; j--) {
        var t2 = endTime - j * 30 * 60 * 1000;
        var v2 = Math.max(current + slopePerStep * j, 2.0);
        points.push([t2, Math.round(v2 * 10) / 10]);
      }
    }
    if (points.length < 2) return;

    function render() {
      var el = document.getElementById('{{ chart_id }}');
      if (!el) return false;
      if (window.Highcharts) {
        Highcharts.chart(el, {
          chart: { type: 'line', height: 56, backgroundColor: 'transparent', animation: false, margin: [2, 2, 2, 2] },
          title: { text: null }, credits: { enabled: false }, legend: { enabled: false }, tooltip: { enabled: false },
          xAxis: { type: 'datetime', visible: false },
          yAxis: { visible: false, softMin: 3, softMax: 11, startOnTick: false, endOnTick: false },
          plotOptions: {
            line: {
              marker: { enabled: false },
              lineWidth: 1.6,
              animation: false,
              enableMouseTracking: false,
              color: '#000'
            }
          },
          series: [{ data: points }]
        });
      } else {
        renderSvg(el, points);
      }
      return true;
    }

    function renderSvg(el, pts) {
      el.innerHTML = '';
      var rect = el.getBoundingClientRect();
      var w = Math.max(Math.floor(rect.width), 160);
      var h = Math.max(Math.floor(rect.height), 50);
      var xs = pts.map(function(p){ return p[0]; });
      var ys = pts.map(function(p){ return p[1]; });
      var xMin = Math.min.apply(null, xs), xMax = Math.max.apply(null, xs);
      if (xMax === xMin) xMax = xMin + 1;
      var yMin = Math.min.apply(null, ys) - 0.5;
      var yMax = Math.max.apply(null, ys) + 0.5;
      if (yMax === yMin) yMax = yMin + 1;
      var poly = pts.map(function(p){
        var x = Math.round(((p[0] - xMin) / (xMax - xMin)) * (w - 4) + 2);
        var y = Math.round((1 - (p[1] - yMin) / (yMax - yMin)) * (h - 4) + 2);
        return x + ',' + y;
      }).join(' ');
      var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('width', '100%');
      svg.setAttribute('height', '100%');
      svg.setAttribute('viewBox', '0 0 ' + w + ' ' + h);
      svg.setAttribute('preserveAspectRatio', 'none');
      var line = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
      line.setAttribute('points', poly);
      line.setAttribute('fill', 'none');
      line.setAttribute('stroke', '#000');
      line.setAttribute('stroke-width', '1.6');
      svg.appendChild(line);
      el.appendChild(svg);
    }

    if (render()) return;
    var attempts = 0;
    var iv = setInterval(function() {
      if (render() || ++attempts > 30) clearInterval(iv);
    }, 150);
  })();
</script>

<style>
  :root {
    --black: #000;
    --white: #fff;
    --gray-soft: rgba(0, 0, 0, 0.12);
    --font: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }

  * { box-sizing: border-box; font-family: var(--font) !important; }
  body { margin: 0; padding: 0; background: var(--white); color: var(--black); }

  .dashboard {
    padding: 16px;
    min-height: 100vh;
    width: 100%;
  }

  .grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 16px;
    min-height: calc(100vh - 32px);
  }

  .col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .col--left { gap: 10px; }

  /* ---------- TIME ---------- */
  .time-block { padding: 2px 2px 0; }
  .time-main {
    font-size: 3.25rem;
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    font-feature-settings: "tnum";
  }
  .time-sub {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    margin-top: 6px;
  }

  .rule { height: 1px; background: var(--black); opacity: 0.2; margin: 2px 0; }

  .section-label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    opacity: 0.7;
    text-transform: uppercase;
  }

  /* ---------- VITALS ---------- */
  .vitals { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .vital {
    background: var(--white);
    border: 1px solid var(--black);
    border-radius: 8px;
    padding: 8px 10px;
  }
  .vital__label {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    opacity: 0.7;
  }
  .vital__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
    margin-top: 4px;
  }
  .vital__value {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1;
    font-feature-settings: "tnum";
  }
  .vital__value--sm { font-size: 1rem; letter-spacing: -0.01em; }
  .vital__icon { width: 18px; height: 18px; color: var(--black); flex-shrink: 0; }

  /* ---------- CARD BASE ---------- */
  .card {
    background: var(--white);
    border: 1px solid var(--black);
    border-radius: 10px;
    padding: 12px;
  }

  /* ---------- GLUCOSE ---------- */
  .card--glucose { display: flex; flex-direction: column; position: relative; }
  .glucose__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
  }
  .trend-pill {
    width: 24px;
    height: 22px;
    border: 1px solid var(--black);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 700;
    background: var(--white);
    flex-shrink: 0;
  }
  .glucose__value {
    font-size: 1.55rem;
    font-weight: 800;
    margin-top: 2px;
    line-height: 1.1;
    font-feature-settings: "tnum";
  }
  .glucose__chart { height: 56px; margin-top: 4px; }
  .glucose__updated {
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    opacity: 0.6;
    margin-top: 4px;
  }

  /* Inverted alert state */
  .card--alert { background: var(--black); color: var(--white); }
  .card--alert .section-label,
  .card--alert .glucose__updated { opacity: 0.85; }
  .card--alert .trend-pill {
    border-color: var(--white);
    color: var(--white);
    background: var(--black);
  }

  /* ---------- SCHEDULE ---------- */
  .card--schedule { padding: 12px 14px; }
  .schedule {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin-top: 6px;
  }
  .schedule__event {
    padding: 2px 12px 2px 0;
    min-width: 0;
  }
  .schedule__event + .schedule__event {
    border-left: 1px solid var(--black);
    padding-left: 14px;
    padding-right: 0;
  }
  .schedule__event--empty {
    grid-column: 1 / -1;
    border-left: none !important;
    padding: 4px 0;
    opacity: 0.55;
  }
  .schedule__title {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .schedule__time {
    font-size: 0.68rem;
    font-weight: 600;
    opacity: 0.65;
    margin-top: 4px;
    letter-spacing: 0.02em;
    font-feature-settings: "tnum";
  }

  /* ---------- TRANSIT ---------- */
  .card--transit { padding: 0; overflow: hidden; }
  .transit__header {
    background: var(--black);
    color: var(--white);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 14px;
  }
  .transit__title {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .transit__icon { width: 18px; height: 18px; color: var(--white); }
  .transit__body { padding: 4px 14px 6px; }
  .transit-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 7px 0;
    min-height: 36px;
  }
  .transit-row__badge {
    min-width: 40px;
    padding: 3px 6px;
    border: 1.5px solid var(--black);
    border-radius: 4px;
    font-weight: 800;
    font-size: 0.72rem;
    text-align: center;
    background: var(--white);
    color: var(--black);
    flex-shrink: 0;
  }
  .transit-row__dest {
    flex: 1;
    font-size: 0.88rem;
    font-weight: 500;
    min-width: 0;
  }
  .transit-row__time {
    font-size: 0.85rem;
    font-weight: 800;
    flex-shrink: 0;
    text-align: right;
    font-feature-settings: "tnum";
  }
  .transit-row__delay {
    font-weight: 600;
    opacity: 0.6;
    font-size: 0.78rem;
  }
  .transit-row__rule { height: 1px; background: var(--gray-soft); }
  .transit-row--empty {
    padding: 14px 0;
    text-align: center;
    opacity: 0.5;
    font-size: 0.85rem;
  }

  /* ---------- WEATHER + FORECAST ---------- */
  .weather-row {
    display: grid;
    grid-template-columns: minmax(160px, 1fr) 2fr;
    gap: 12px;
  }
  .card--now {
    background: var(--black);
    color: var(--white);
    border-color: var(--black);
    display: flex;
    align-items: center;
    gap: 14px;
